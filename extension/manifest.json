{
  "manifest_version": 3,
  "name": "Gestura",
  "version": "0.1.0",
  "description": "Accessibility captions and communication tools. First target: synchronized YouTube transcripts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Gestura",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "sidePanel", "activeTab", "camera"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "shared/messages.js",
        "shared/caption-segment.js",
        "shared/youtube-id.js",
        "adapters/website-adapter.js",
        "adapters/generic-video-adapter.js",
        "adapters/youtube-adapter.js",
        "adapters/registry.js",
        "content/floating-button.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
