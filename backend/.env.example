# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

APP_NAME=GESTURA API
APP_VERSION=0.1.0

# Server binding (used by run.py)
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing one folder per ISL sign.
# Defaults to <repo-root>/videos when unset.
# VIDEOS_DIR=C:\path\to\videos

# Directory containing model.pt and metadata.json for ASL recognition.
# Defaults to <repo-root>/backend/models/asl/current when unset.
# MODELS_DIR=C:\path\to\backend\models\asl\current

# Maritime AI Agents Platform Integration (VIHAAN-X Challenge: Best Use of Maritime)
# Use participant code VIHAANX at maritime.sh for 3 months free Scale plan
MARITIME_API_KEY=
MARITIME_AGENT_ENDPOINT=https://api.maritime.sh/v1/agents
MARITIME_SCALE_TIER=Scale Tier (VIHAANX Hackathon Access)

# Prune AI Security, Semantic Caching & Gateway (VIHAAN-X Challenge: Best Use of Prune)
# Activate 1 month free Prune Pro access
PRUNE_API_KEY=
PRUNE_GATEWAY_URL=https://gateway.useprune.com/v1
PRUNE_PRO_TIER=Prune Pro (Hackathon Access)

